FROM node:22-alpine

WORKDIR /app

# Copy root backend package
COPY package*.json ./
RUN npm install --production

# Install dependencies for gateway and each microservice
COPY gateway/package*.json ./gateway/
RUN cd gateway && npm install --production

COPY services/auth-service/package*.json ./services/auth-service/
RUN cd services/auth-service && npm install --production

COPY services/billing-service/package*.json ./services/billing-service/
RUN cd services/billing-service && npm install --production

COPY services/interview-service/package*.json ./services/interview-service/
RUN cd services/interview-service && npm install --production

COPY services/resume-service/package*.json ./services/resume-service/
RUN cd services/resume-service && npm install --production

COPY services/roadmap-service/package*.json ./services/roadmap-service/
RUN cd services/roadmap-service && npm install --production

# Copy source files
COPY . .

# Ensure start script has executable permissions
RUN chmod +x ./start.sh

# Render sets PORT dynamically (defaults to 8000 locally)
ENV PORT=8000
ENV NODE_ENV=production
EXPOSE 8000

CMD ["./start.sh"]
